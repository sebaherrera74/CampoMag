import math
import numpy as np
import matplotlib.pyplot as plt

WAVEFORMS = ("Sine", "Square", "Triangle", "Sawtooth", "DC")

def waveform_value_minus1_to_plus1(kind: str, phase_0_to_1: float) -> float:
    k = kind.lower()
    p = phase_0_to_1 - math.floor(phase_0_to_1)
    if k == "sine":
        return math.sin(2.0 * math.pi * p)
    if k == "square":
        return 1.0 if p < 0.5 else -1.0
    if k == "triangle":
        return 4.0 * abs(p - 0.5) - 1.0
    if k == "sawtooth":
        return 2.0 * p - 1.0
    if k == "dc":
        return 0.0
    return math.sin(2.0 * math.pi * p)

def generate_signal(kind: str = "Sine", freq_hz: float = 200.0, fs_hz: float = 8000.0,
                    amplitude: float = 0.8, offset: float = 0.5, duration_s: float = 0.05,
                    vref_volts: float = 3.3):
    n = int(duration_s * fs_hz)
    t = np.arange(n) / fs_hz
    phase = (t * freq_hz) % 1.0
    vec = np.vectorize(lambda ph: waveform_value_minus1_to_plus1(kind, ph))
    y_m1_p1 = vec(phase)
    half_amp = 0.5 * amplitude
    y_0_1 = np.clip(offset + half_amp * y_m1_p1, 0.0, 1.0)
    volts = y_0_1 * vref_volts
    return t, volts

def plot_signal(kind="Sine", freq_hz=200.0, fs_hz=8000.0, amplitude=0.8, offset=0.5, duration_s=0.05, vref_volts=3.3):
    t, v = generate_signal(kind, freq_hz, fs_hz, amplitude, offset, duration_s, vref_volts)
    plt.figure(figsize=(9, 3))
    plt.plot(t * 1000.0, v)
    plt.xlabel("Tiempo (ms)")
    plt.ylabel("Voltaje (V)")
    plt.title(f"{kind} | f={freq_hz} Hz, fs={fs_hz} Hz, amp={amplitude}, offset={offset}")
    plt.grid(True)
    plt.show()

plot_signal()
# Simulación de Generador de Señales (Colab)

Este notebook simula formas de onda (Sine, Square, Triangle, Sawtooth, DC) como las que genera la app de Raspberry Pi. No requiere hardware; sirve para visualizar y ajustar parámetros antes de usar el DAC MCP4725/PWM en la Raspberry.

- Ajusta frecuencia, amplitud, offset y fs.
- Visualiza en unidades de voltaje considerando un Vref (p. ej., 3.3 V).
